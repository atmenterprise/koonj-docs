{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Koonj documentation",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/logo/koonj-mark.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Installation",
        "pages": [
          "installation/docker",
          "installation/on-premise",
          "installation/operations",
          "installation/recall-gateway"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/user",
          "guides/administration"
        ]
      },
      {
        "group": "Developers",
        "pages": [
          "developers/local-development",
          "api/overview",
          "api/endpoints"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Koonj source",
          "icon": "github",
          "href": "https://github.com/atmenterprise/koonj"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/koonj-mark.svg",
    "dark": "/logo/koonj-mark.svg"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "image": "/images/atm-banner-16x9-clean.jpg",
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "description": "Install and use Koonj to catalog, archive, and recall files across mounted storage and S3."
}
