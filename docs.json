{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Koonj documentation",
  "colors": {
    "primary": "#745A00",
    "light": "#FFDE59",
    "dark": "#745A00"
  },
  "favicon": "/logo/koonj-mark.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Koonj source",
          "icon": "github",
          "href": "https://github.com/atmenterprise/koonj"
        }
      ]
    },
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart",
          "architecture"
        ]
      },
      {
        "group": "Use Koonj",
        "pages": [
          "guides/user",
          "guides/administration"
        ]
      },
      {
        "group": "Cloud deployment",
        "pages": [
          "installation/docker",
          "installation/configuration",
          "installation/operations",
          "installation/recall-gateway"
        ]
      },
      {
        "group": "Developers",
        "pages": [
          "api/overview",
          "api/endpoints",
          "api/mcp",
          "developers/local-development"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/koonj-mark.svg",
    "dark": "/logo/koonj-mark.svg"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "color": {
      "light": "#FCFCFC",
      "dark": "#18181B"
    }
  },
  "description": "Use and deploy Koonj to catalog, archive, and recall files across cloud-mounted storage and S3-compatible buckets.",
  "redirects": [
    {
      "source": "/installation/on-premise",
      "destination": "/installation/docker"
    }
  ]
}
